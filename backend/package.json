{
  "name": "creva-contact-api",
  "version": "1.0.0",
  "private": true,
  "description": "Creva Solutions contact form API: saves inquiries to Supabase and sends email via GoDaddy SMTP (Render web service)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "nodemailer": "^10.0.15"
  },
  "devDependencies": {
    "mailparser": "^3.9.36",
    "selfsigned": "^5.5.0",
    "smtp-server": "^3.19.17"
  }
}
