# Copy to .env for local development only. On Render, set these in Dashboard -> Environment.
# Never commit real values.

PORT=10000
NODE_ENV=production

# Supabase (public anon key is enough: RLS allows INSERT into contact_submissions)
SUPABASE_URL=https://xtivwelnoccdontbrxft.supabase.co
SUPABASE_ANON_KEY=

# The ONE notification email per inquiry goes here. The customer never receives an email.
ADMIN_NOTIFICATION_EMAIL=crevasolution@gmail.com

# Email delivery: "smtp" (Nodemailer) or "resend" (HTTPS API).
# NOTE: Render's FREE plan blocks outbound SMTP ports 25/465/587 - use "resend" there, or a paid instance for SMTP.
EMAIL_PROVIDER=smtp

# SMTP account that sends the notification (also the default sender)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# Only for EMAIL_PROVIDER=resend
RESEND_API_KEY=

# Sender shown on the notification (defaults to SMTP_USER when empty)
MAIL_FROM=
MAIL_FROM_NAME=Creva Solutions Website

# How long a request waits for the notification before answering (ms)
EMAIL_WAIT_MS=15000

# Browser origins allowed to call the API (www redirects to the apex domain)
ALLOWED_ORIGINS=https://crevasolution.in
