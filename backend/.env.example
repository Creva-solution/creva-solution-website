# Copy to .env for local development only. On Render, set these in Dashboard -> Environment.
# Never commit real values.

PORT=10000
NODE_ENV=production

# Supabase (public anon key is enough: RLS allows INSERT into contact_submissions)
SUPABASE_URL=https://xtivwelnoccdontbrxft.supabase.co
SUPABASE_ANON_KEY=

# Email delivery: "resend" (HTTPS API - works on Render Free) or "smtp" (GoDaddy SMTP - needs a paid
# Render instance, because Render Free blocks outbound ports 25/465/587).
EMAIL_PROVIDER=resend
RESEND_API_KEY=

# Only for EMAIL_PROVIDER=smtp (GoDaddy, verified: smtpout.secureserver.net, 465, implicit SSL)
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@crevasolution.in
SMTP_PASSWORD=

MAIL_FROM=info@crevasolution.in
MAIL_FROM_NAME=Creva Solutions
# New-inquiry notification recipients (comma-separated)
ADMIN_EMAIL=info@crevasolution.in

# How long a request waits for the emails before answering (ms)
EMAIL_WAIT_MS=15000

# Comma-separated list of browser origins allowed to call the API (www redirects to the apex domain)
ALLOWED_ORIGINS=https://crevasolution.in
